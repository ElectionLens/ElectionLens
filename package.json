{
  "name": "election-lens",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:run",
    "validate:e2e": "npm run build && playwright test --project=chromium",
    "prepare": "husky install || true",
    "clean": "rm -rf dist coverage node_modules/.cache",
    "analyze:geo": "node scripts/optimize-geojson.mjs",
    "data:assembly-geo:orphans-check": "node scripts/cleanup-assembly-geojson-orphans.mjs --ci",
    "data:assam-ac:fetch": "node scripts/fetch-datameet-assam-ac-geojson.mjs",
    "data:assam-ac:replace": "node scripts/replace-assam-ac-geojson.mjs",
    "data:fix-pc-2014-acwise": "node scripts/fix-pc-2014-acwise-duplicates.mjs",
    "data:verify-elections": "node scripts/verify-election-data-integrity.mjs",
    "data:verify-elections:ci": "node scripts/verify-election-data-integrity.mjs --ci",
    "data:rebuild-pc-2024:eci-segment-xls": "python3 scripts/rebuild-pc-2024-from-eci-segment-xls.py",
    "data:fetch-ac-may2026": "node scripts/fetch-may2026-assembly-from-eci.mjs",
    "data:fetch-ac-may2026:poll": "node scripts/fetch-may2026-assembly-from-eci.mjs --poll 180",
    "generate:ac-2026": "node scripts/generate-ac-2026-upcoming.mjs",
    "data:ac-2026-placeholder": "node scripts/add-ac-2026-placeholder-all-states.mjs",
    "data:ac-years-through-2029": "node scripts/sync-ac-years-through-2029.mjs",
    "fetch:tn-2026-dmk-hindu": "node scripts/fetch-tn-2026-dmk-hindu.mjs",
    "fetch:tn-2026-dmk-voterlist": "node scripts/fetch-tn-2026-dmk-voterlist.mjs",
    "fetch:tn-2026-admk": "node scripts/fetch-tn-2026-admk.mjs",
    "fetch:tn-2026-admk-voterlist": "node scripts/fetch-tn-2026-admk-voterlist.mjs",
    "fetch:tn-2026-tvk-hindu": "node scripts/fetch-tn-2026-tvk-hindu.mjs",
    "fetch:tn-2026-pmk": "node scripts/fetch-tn-2026-pmk.mjs",
    "fetch:tn-2026-ntk-tnliv": "node scripts/fetch-tn-2026-ntk-tnliv.mjs",
    "fetch:tn-2026-ammk-voterlist": "node scripts/fetch-tn-2026-ammk-voterlist.mjs",
    "merge:tn-2026-announced": "node scripts/merge-tn-2026-announced.mjs",
    "fetch:wb-2026-voterlist-master": "node scripts/fetch-wb-2026-voterlist-master.mjs",
    "fetch:kl-2026-voterlist": "node scripts/fetch-kl-2026-voterlist.mjs",
    "merge:wb-kl-2026-announced": "node scripts/merge-wb-kl-2026-announced.mjs",
    "refresh:ac-2026-announced": "node scripts/generate-ac-2026-upcoming.mjs && node scripts/fetch-tn-2026-dmk-voterlist.mjs && node scripts/fetch-tn-2026-dmk-hindu.mjs && node scripts/fetch-tn-2026-admk.mjs && node scripts/fetch-tn-2026-admk-voterlist.mjs && node scripts/fetch-tn-2026-tvk-hindu.mjs && node scripts/fetch-tn-2026-pmk.mjs && node scripts/fetch-tn-2026-ntk-tnliv.mjs && node scripts/fetch-tn-2026-ammk-voterlist.mjs && node scripts/merge-tn-2026-announced.mjs && node scripts/fetch-wb-2026-voterlist-master.mjs && node scripts/fetch-kl-2026-voterlist.mjs && node scripts/merge-wb-kl-2026-announced.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.3",
    "firebase": "^12.7.0",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.15.0",
    "pmtiles": "^4.3.0",
    "protomaps-leaflet": "^5.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^20.0.11",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "munkres": "^2.0.4",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^5.0.8",
    "vitest": "^1.2.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  }
}
